# Cherry backend config. Copy to ".env.local" for local dev, or set these as
# Environment Variables in your Vercel project. NEVER commit a real key.

ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional overrides (sensible defaults baked in):
# CHERRY_MODEL=claude-sonnet-4-6       # default; set claude-opus-4-8 on Vercel Pro for richer triage/drafts
# CHERRY_MAX_SEARCHES=3                # web searches per query (cost/time lever)
# CHERRY_DAILY_CAP=200                 # hard ceiling on triage queries/day
# CHERRY_DRAFT_DAILY_CAP=300           # hard ceiling on draft requests/day
# CHERRY_JUDGE_DAILY_CAP=400           # hard ceiling on judge requests/day
# CHERRY_JUDGE_MODEL=claude-sonnet-4-6 # override judge independently of CHERRY_MODEL
# CHERRY_PER_IP_PER_MIN=6              # per-visitor rate limit (triage default; draft/route/judge use 12)
# CHERRY_ALLOW_ORIGIN=https://cherry.vercel.app   # lock CORS in production
# CHERRY_SLACK_WEBHOOK=https://hooks.slack.com/services/...   # enables "Send to Slack" (also hooks.slack-gov.com)
