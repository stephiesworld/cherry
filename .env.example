# Cherry backend config. Copy to ".env.local" for local dev, or set these as
# Environment Variables in your Vercel project. NEVER commit a real key.

ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional overrides (sensible defaults baked in):
# CHERRY_MODEL=claude-opus-4-8        # flip to claude-sonnet-4-6 to cut cost
# CHERRY_MAX_SEARCHES=5               # web searches per query (cost lever)
# CHERRY_DAILY_CAP=200               # hard ceiling on queries/day (abuse guard)
# CHERRY_PER_IP_PER_MIN=6            # per-visitor rate limit
# CHERRY_ALLOW_ORIGIN=https://cherry.vercel.app   # lock CORS in production
